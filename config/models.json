{
  "call_log": "logs/model_calls.jsonl",
  "providers": {
    "meta": {
      "base_url": "https://api.meta.ai/v1",
      "api_key_env": "META_API_KEY",
      "timeout_s": 400,
      "max_retries": 3
    }
  },
  "roles": {
    "translator":   {"provider": "meta", "model": "muse-spark-1.3", "max_tokens": 4000, "max_tokens_retry": 8000, "reasoning_effort": "low", "samples": 3},
    "faithfulness": {"provider": "meta", "model": "muse-spark-1.3", "max_tokens": 4000, "max_tokens_retry": 8000, "reasoning_effort": "low"},
    "ledger":       {"provider": "meta", "model": "muse-spark-1.3", "max_tokens": 4000, "max_tokens_retry": 8000, "reasoning_effort": "low"},
    "reviewer":     {"provider": "meta", "model": "muse-spark-1.3", "max_tokens": 8000, "max_tokens_retry": 12000, "reasoning_effort": "low"},
    "fixer":        {"provider": "meta", "model": "muse-spark-1.3", "max_tokens": 4000},
    "vision":       {"provider": "meta", "model": "muse-spark-1.3", "max_tokens": 4000},
    "segment":      {"provider": "meta", "model": "sam-3.1", "api": "responses"}
  },
  "pricing_per_million_tokens_usd": {
    "muse-spark-1.3": {"input": 1.25, "output": 4.25, "cached_input": 0.15},
    "muse-spark-1.2": {"input": 1.25, "output": 4.25, "cached_input": 0.15},
    "muse-spark-1.1": {"input": 1.25, "output": 4.25, "cached_input": 0.15},
    "muse-wonder-1.0": {"input": 4.00, "output": 20.00, "cached_input": 0.20},
    "sam-3.1": null
  },
  "sam_pricing_usd": {"per_1000_images": 2.50, "per_1000_video_frames": 0.20}
}
